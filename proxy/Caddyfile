# =============================================================================
# proxy/Caddyfile -- the identity boundary.
#
# WHY CADDY AND NOT NGINX
#
#   1. Header deletion is a first-class verb. `request_header -X-Auth-Request-User`
#      removes the header, full stop. nginx has no delete: the idiom is
#      `proxy_set_header X-Auth-Request-User "";`, which sends an empty header
#      rather than none, and which silently does nothing if any other
#      proxy_set_header appears in a more specific block (nginx replaces the
#      whole inherited set instead of merging). In a config whose entire job is
#      "the client must not be able to supply this header", a verb that means
#      what it says is worth more than familiarity.
#
#   2. SSE works by default. /api/events is a long-lived text/event-stream.
#      Caddy streams proxied responses and flushes event-streams immediately.
#      nginx buffers: SSE needs proxy_buffering off, proxy_cache off,
#      proxy_http_version 1.1, proxy_read_timeout raised from 60s, and usually
#      an X-Accel-Buffering escape hatch -- five chances to get it wrong, with
#      a failure mode (events arrive in a batch minutes later) that looks like
#      an application bug.
#
#   3. One file. No sites-enabled/, no mime.types, no separate TLS block, and
#      automatic HTTPS from a hostname when Caddy is the public edge.
#
# WHAT THIS FILE GUARANTEES
#
#   Every request that reaches the API has had any client-supplied identity
#   header stripped, and on every route but the agent API's (below) replaced
#   with one this proxy chose; on the agent routes none is set at all. That
#   guarantee is worth exactly as much as the network rule that the API has no
#   other way in -- see the `networks:` comments in compose.yaml. A reachable
#   API makes this file decorative.
# =============================================================================
{
	# No admin API: it is an unauthenticated config-write endpoint on :2019 and
	# nothing here needs it.
	admin off

	# Trust X-Forwarded-For only from private ranges, so {remote_host} in the
	# access log is the real peer rather than whatever a client claimed. This
	# affects LOGGING only -- identity never comes from a forwarded header.
	# (The Server header is removed in the site block below; this directive
	# has nothing to do with it, despite what the old comment here said.)
	servers {
		trusted_proxies static private_ranges
	}
}

# http://:80 locally and behind a cloud SSO front door that terminates TLS.
# A bare hostname (governance.example.org) instead makes Caddy the public edge
# and provisions a certificate automatically -- then publish 80 and 443.
{$SITE_ADDRESS:http://:80} {
	log {
		output stdout
		# Keep a query string out of the log on the agent routes (#164). The token is read
		# from the Authorization header only (Caddy already redacts that header's value
		# in its log), but a client that puts one in a URL anyway would have it written
		# here. Only /api/agent/ URIs are touched; every other line is as it was.
		format filter {
			wrap console
			fields {
				request>uri regexp "(?i)^(/api/agent/[^?]*)\?.*$" "$1?[redacted]"
			}
		}
	}

	encode zstd gzip

	# -------------------------------------------------------------------------
	# Security headers, at the SITE level so /api/* gets them too. They used to
	# live in the static `handle` block only, which left every JSON response
	# without so much as nosniff.
	# -------------------------------------------------------------------------
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"

		# Caddy serves this over plain HTTP when a cloud front door terminates
		# TLS, and HSTS on a plaintext response is ignored by browsers -- so
		# this is harmless there and load-bearing when SITE_ADDRESS is a
		# hostname and Caddy is the public edge. Add `preload` only once you
		# are sure every subdomain can do HTTPS, because it is hard to undo.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# The dashboard is one file with everything inline and no third-party
		# origins, so the policy can be this tight.
		#
		# The script is allowed by its hash, not by 'unsafe-inline'.
		#
		# An injected <script>, an event handler or a javascript: URL is then
		# refused by the browser even if the page failed to escape something, and
		# connect-src and img-src cannot reach another origin, so an injection is
		# a blocked request rather than an exfiltration channel. Style stays
		# inline, because the app styles itself.
		#
		# The policy is GENERATED from the built page (scripts/build_app.py writes
		# proxy/csp.caddy), because the hash changes with every build. compose.yaml
		# mounts it and proxy/Dockerfile copies it, at this path (#154).
		import /etc/caddy/csp.caddy

		# Caddy announces itself otherwise. Nothing needs to know.
		-Server
	}

	# -------------------------------------------------------------------------
	# The API, and the identity handoff.
	#
	# `route` keeps these in the order written, and the order IS the security
	# property: strip the canonical headers, set them from the configured
	# source, strip the provider headers, reject if empty, forward.
	#
	# The provider strip has to come AFTER the set, not before. It used to come
	# before, and that silently broke every cloud deployment this repository
	# documents: step 2 reads the provider header through a placeholder, so
	# removing it first made the placeholder resolve to "" and step 3 answered
	# 401 to every request. The only identity setting that worked was a literal
	# string -- the one configuration that makes every visitor the same person.
	# -------------------------------------------------------------------------
	# -------------------------------------------------------------------------
	# The agent API (#164): read-only GET routes that answer to a bearer token,
	# not to a signed-in session. An agent has no SSO session, so this is the one
	# place a request reaches the API without the identity handoff below.
	#
	# It is safe because of what this block does NOT do: it never sets an identity
	# header. Everything that could be taken for one is STRIPPED, so a client that
	# forges X-Auth-Request-Email here gives the API nothing, and a request that
	# this block forwards by mistake to a non-agent route reaches the API with no
	# identity and gets a 401. The API, for its part, ignores identity headers on
	# these routes and accepts a token on no other route.
	#
	# Handles are mutually exclusive and run in the order written, so this one
	# stays above `handle /api/*`. Anything under /api/agent/ that is not one of the
	# three GET routes is answered here with a 404 and goes no further: not a
	# POST, not a DELETE, not a path the API does not serve. (/api/agent-tokens,
	# which mints and revokes, is NOT under /api/agent/ and goes through the
	# single sign-on handle below, as a person's session.)
	#
	# The operator must also let this path through a front door that authenticates
	# every request: docs/agent-api.md says how, per front door. This file cannot.
	# -------------------------------------------------------------------------
	@agentread {
		method GET
		path /api/agent/me /api/agent/portfolio /api/agent/projects/*
	}
	handle @agentread {
		request_body {
			max_size 16KB
		}

		route {
			# STRIP every header the API, or a front door in front of this proxy,
			# could read as "who is this". The same list as the single sign-on
			# handle strips after it sets, here without the set.
			request_header -X-Auth-Request-User
			request_header -X-Auth-Request-Name
			request_header -X-Auth-Request-Email
			request_header -X-Goog-Authenticated-User-Email
			request_header -X-Goog-Authenticated-User-Id
			request_header -X-Goog-Iap-Jwt-Assertion
			request_header -X-Amzn-Oidc-Identity
			request_header -X-Amzn-Oidc-Data
			request_header -X-Amzn-Oidc-Accesstoken
			request_header -X-Ms-Client-Principal
			request_header -X-Ms-Client-Principal-Id
			request_header -X-Ms-Client-Principal-Name
			request_header -X-Ms-Client-Principal-Idp
			request_header -X-Forwarded-Email
			request_header -X-Forwarded-User
			request_header -X-Forwarded-Preferred-Username

			# The token is a credential in a response's request: never cache the answer.
			header Cache-Control "no-store"

			reverse_proxy api:8000 {
				flush_interval -1
				# The agent's own source address, for the read trail and the
				# per-source limit. The API sets nothing on it.
				header_up X-Real-IP {remote_host}
				# The same shared secret as every route: the second lock the API
				# checks (PROXY_SHARED_SECRET) still applies here.
				header_up X-Proxy-Secret "{$PROXY_SHARED_SECRET}"
				transport http {
					dial_timeout 5s
				}
			}
		}
	}

	handle /api/agent/* {
		respond "Not found." 404
	}

	handle /api/* {
		# A project document is a governance record: kilobytes. Nothing
		# legitimate posts megabytes, and without a cap an authenticated user
		# can write until the volume fills -- and every such write is also
		# copied permanently into project_version, where the append-only
		# trigger prevents reclaiming the space.
		#
		# `2MB` is SI: 2,000,000 bytes, not 2 MiB. Caddy enforces it by capping
		# the body reader rather than by rejecting on Content-Length, so the
		# upstream sees the request line and at most that many bytes -- never a
		# complete over-size document -- and the client gets 413.
		# tests/test_proxy_identity.py asserts exactly that.
		request_body {
			max_size 2MB
		}

		route {
			# 1. STRIP. Unconditionally remove any copy the client sent. A
			#    browser that sets X-Auth-Request-User by hand gets it deleted
			#    here, before anything else looks at the request. These names
			#    are the contract with the API's AUTH_HEADER_* settings in
			#    compose.yaml -- change one, change both.
			request_header -X-Auth-Request-User
			request_header -X-Auth-Request-Name
			request_header -X-Auth-Request-Email

			# 2. SET from a source the operator configured.
			#
			#    IDENTITY_ID_SOURCE is either a literal string (local dev:
			#    "dev@localhost") or a Caddy placeholder naming the header the
			#    cloud's SSO front door set, e.g.
			#
			#      GCP  IAP          {http.request.header.X-Goog-Authenticated-User-Email}
			#      AWS  ALB + OIDC   {http.request.header.X-Amzn-Oidc-Identity}
			#      Azure Easy Auth   {http.request.header.X-Ms-Client-Principal-Name}
			#
			#    Caddy substitutes {$VAR} while parsing this file, so the
			#    placeholder is resolved per request afterwards. .env.example
			#    lists all three verbatim.
			#
			#    The values are QUOTED, and must stay quoted. Unquoted,
			#    `request_header X-Auth-Request-Name Dev User` is three
			#    arguments, which is Caddy's find-and-replace form
			#    (field, search, replace) -- it silently does nothing to a
			#    header that does not exist yet, and the identity vanishes
			#    with no error anywhere. Any display name with a space in it
			#    hits this.
			#    NO DEFAULT VALUE. These used to read
			#    {$IDENTITY_ID_SOURCE:dev@localhost}, which fails OPEN: with
			#    the variable unset -- a fresh deployment, a typo'd .env, a
			#    cloud task definition missing one entry -- every anonymous
			#    request was stamped with a real-looking identity and sailed
			#    past the check below, because "dev@localhost" is not empty.
			#    Unset now resolves to "" and the request is rejected at
			#    step 3. compose.dev.yaml sets the dev identity explicitly,
			#    which is the only place a fixed identity belongs.
			request_header X-Auth-Request-User "{$IDENTITY_ID_SOURCE}"
			request_header X-Auth-Request-Name "{$IDENTITY_NAME_SOURCE}"
			request_header X-Auth-Request-Email "{$IDENTITY_EMAIL_SOURCE}"

			# 2b. STRIP the upstream providers' headers, now that step 2 has
			#     read whichever one it was pointed at.
			#
			#     THIS MUST COME AFTER THE SET, NOT BEFORE. It used to come
			#     before, and that silently broke every cloud deployment this
			#     repository documents: step 2 reads a provider header through
			#     a placeholder, so deleting it first made the placeholder
			#     resolve to "" and step 3 answered 401 to every request. The
			#     only identity setting that worked was a literal string -- the
			#     one configuration that makes every visitor the same person.
			#
			#     What it is for: the API reads AUTH_HEADER_* and nothing else,
			#     and a stray X-Goog-/X-Amzn-/X-Ms- header arriving there would
			#     be a second, unchecked answer to "who is this" the moment
			#     somebody also set IDENTITY_MODE. It also keeps them out of the
			#     API's logs.
			#
			#     What it is NOT for: it does not stop a client that can reach
			#     THIS PROXY DIRECTLY from setting a provider header itself and
			#     having step 2 copy it into X-Auth-Request-*. Nothing here can
			#     -- step 2's whole job is to trust that header. The only
			#     control is the network: Caddy must be reachable only through
			#     the SSO front door, exactly as the API must be reachable only
			#     through Caddy. See "Close the back door" in docs/deploy.md.
			request_header -X-Goog-Authenticated-User-Email
			request_header -X-Goog-Authenticated-User-Id
			request_header -X-Goog-Iap-Jwt-Assertion
			request_header -X-Amzn-Oidc-Identity
			request_header -X-Amzn-Oidc-Data
			request_header -X-Amzn-Oidc-Accesstoken
			request_header -X-Ms-Client-Principal
			request_header -X-Ms-Client-Principal-Id
			request_header -X-Ms-Client-Principal-Name
			request_header -X-Ms-Client-Principal-Idp
			request_header -X-Forwarded-Email
			request_header -X-Forwarded-User
			request_header -X-Forwarded-Preferred-Username

			# 3. REJECT an anonymous request here rather than passing an empty
			#    header downstream and hoping the API notices. This fires when
			#    the SSO front door is misconfigured or has been bypassed: the
			#    source header is absent, the placeholder resolves to "", and
			#    the request never reaches the API.
			#
			#    Both headers are checked. The API authenticates on the EMAIL
			#    header (AUTH_HEADER_EMAIL -> identity_header), so testing only
			#    the user header would let a request through with the one
			#    header that actually matters empty.
			@anonymous expression {http.request.header.X-Auth-Request-Email} == "" || {http.request.header.X-Auth-Request-User} == ""
			respond @anonymous "No authenticated identity. This API is only reachable through the single sign-on proxy." 401 {
				close
			}

			# 4. FORWARD.
			reverse_proxy api:8000 {
				# flush_interval -1 disables response buffering for every /api
				# response, not just the event stream. The cost is a syscall
				# per write on a low-traffic internal tool; the benefit is that
				# /api/events cannot regress into a buffered endpoint because
				# somebody changed a content type.
				flush_interval -1

				# For the API's access log only. The API must NOT use these
				# for authorization -- identity is X-Auth-Request-User and
				# nothing else. (X-Forwarded-For and X-Forwarded-Proto are set
				# by Caddy already.)
				header_up X-Real-IP {remote_host}

				# PROXY_SHARED_SECRET: prove to the API that this request came
				# through here. The API only enforces it when it has the same
				# value (compose.yaml passes one variable to both). `header_up`
				# SETS the header, so whatever the client sent under this name
				# is replaced, never forwarded; do not add a `header_up -X-Proxy-Secret`
				# beside it, because Caddy applies deletes after sets and the
				# secret would vanish. Unset, the value is empty and the API does
				# not check. The name is the API's PROXY_SECRET_HEADER default.
				header_up X-Proxy-Secret "{$PROXY_SHARED_SECRET}"

				# A dead API should look dead, not like a hung page.
				transport http {
					dial_timeout 5s
					# No read timeout: /api/events is meant to stay open.
				}
			}
		}
	}

	# -------------------------------------------------------------------------
	# The dashboard: one pre-built, self-contained file, mounted read-only from
	# the host at docs/app/ (built by `pixi run build-app`, never by Docker).
	# -------------------------------------------------------------------------
	handle {
		root * /srv/app
		file_server

		# The dashboard is regenerated by a build step and its URL never
		# changes, so a long cache would serve a stale app after every deploy.
		header Cache-Control "no-cache"

		# It is a single inline-everything HTML file with no third-party
		# origins, so the policy can be this tight.
		header X-Content-Type-Options "nosniff"
		header X-Frame-Options "DENY"
		header Referrer-Policy "same-origin"
	}
}
