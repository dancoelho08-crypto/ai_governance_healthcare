# =============================================================================
# Copy to .env and edit:   cp .env.example .env
#
# .env is read automatically by `docker compose`. It is git-ignored. Nothing in
# this file is a real secret -- every value here is either a safe default or an
# obvious placeholder you are expected to replace.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_DB=chai
POSTGRES_USER=chai

# REQUIRED, and deliberately EMPTY. compose.yaml has no default, so the stack
# refuses to start until you put a real value here. It is empty rather than a
# placeholder string because `${VAR:?...}` only catches unset-or-empty -- a
# placeholder like "replace-me" is a non-empty value and sails straight through
# the guard, which is how sample passwords reach production.
#
#   POSTGRES_PASSWORD=$(openssl rand -base64 32)
#
# Postgres reads this ONCE, when it initializes an empty data directory. On an
# existing pgdata volume it is ignored, so changing it here later changes what
# the API presents and not what the database accepts -- and the API stops being
# able to reach its own database. `make doctor` detects exactly that and prints
# the ALTER ROLE to run. See docs/self-hosting.md.
POSTGRES_PASSWORD=

# The password of the RESTRICTED role the API connects as (#48). A DIFFERENT value
# from POSTGRES_PASSWORD, generated the same way:
#
#   APP_POSTGRES_PASSWORD=$(openssl rand -base64 32)
#
# POSTGRES_PASSWORD is the table owner's. The owner can switch off the triggers
# that keep the audit log and version history append-only, so only the one-shot
# `migrate` service holds it. `migrate` creates this role and grants it exactly
# what the API needs (`python -m app.migrate --print-grants` lists it), and the API
# container never sees the owner's password. Unlike POSTGRES_PASSWORD this one is
# applied on every start, so rotating it is a restart.
APP_POSTGRES_PASSWORD=
# APP_POSTGRES_USER=chai_app

# In a cloud deployment you will usually drop the `db` service entirely and
# point the API at a managed instance (Cloud SQL, RDS, Azure Database for
# PostgreSQL). Then set DATABASE_URL instead of the three values above, and
# prefer the platform's identity-based connection over a password:
#   DATABASE_URL=postgresql://chai@/chai?host=/cloudsql/PROJECT:REGION:INSTANCE
#
# Any password works in POSTGRES_PASSWORD above: the API assembles the connection
# URL itself and percent-encodes it. If you write DATABASE_URL by hand you must
# do that yourself, because a "/" "@" ":" "?" or "#" in the password otherwise
# ends the URL early and the API refuses to start:
#   python3 -c 'import sys, urllib.parse as u
#   print(u.quote(sys.argv[1], safe=""))' 'the-password'

# -----------------------------------------------------------------------------
# Where the proxy listens
# -----------------------------------------------------------------------------
HTTP_PORT=8080
# Bind address for the published port. Loopback by default: this stack speaks
# plain HTTP, so publishing it to the network means serving a governance record
# in cleartext. Change this only once TLS is terminated in front of it, either
# by the cloud's SSO front door or by Caddy itself (set SITE_ADDRESS to a
# hostname below).
HTTP_BIND=127.0.0.1

# Caddy's site address.
#   http://:80          plain HTTP -- correct behind a cloud SSO front door
#                       (IAP, ALB, Front Door / Easy Auth) that terminates TLS
#   governance.example.org
#                       Caddy is the public edge and gets its own certificate
#                       automatically; publish 80 and 443 in that case
SITE_ADDRESS=http://:80

# -----------------------------------------------------------------------------
# IDENTITY -- the one setting that decides who the application thinks you are.
#
# The proxy deletes any identity header the browser sent, then sets
# X-Auth-Request-User / -Name / -Email from the three values below. Each is
# either a literal string or a Caddy placeholder naming a header the SSO front
# door set. Pick ONE block.
#
# Required: IDENTITY_ID_SOURCE has no default in compose.yaml, because a stack
# that silently falls back to an anonymous user is worse than one that refuses
# to start.
# -----------------------------------------------------------------------------

# EMPTY BY DEFAULT, and that is the point. An unset value makes the proxy
# reject every request with 401 (proxy/Caddyfile step 3) -- a stack that
# refuses to serve is a loud failure. A LITERAL value here, by contrast, stamps
# every visitor as that same person: anyone who reaches the port becomes them,
# owns every project, and nothing in the logs or the UI says so.
#
# So do not put a literal here. For local development use `make dev`, which
# applies compose.dev.yaml -- that file supplies a fixed developer identity and
# is the only place a literal belongs.
IDENTITY_ID_SOURCE=
IDENTITY_NAME_SOURCE=
IDENTITY_EMAIL_SOURCE=

# --- Local development, no SSO ------------------------------------------------
# Nothing to set. `make dev` supplies DEV_IDENTITY_* (bottom of this file)
# through compose.dev.yaml.

# --- Google Cloud: Identity-Aware Proxy ---------------------------------------
# IAP sets these on every request it forwards and overwrites any client copy.
# The values arrive prefixed "accounts.google.com:", so IDENTITY_STRIP_PREFIX
# is required here -- without it every sign-off is attributed to an id that
# matches nothing in your directory, and nothing surfaces the mistake until
# somebody reconciles the audit log against a staff list.
# IDENTITY_ID_SOURCE={http.request.header.X-Goog-Authenticated-User-Id}
# IDENTITY_NAME_SOURCE={http.request.header.X-Goog-Authenticated-User-Email}
# IDENTITY_EMAIL_SOURCE={http.request.header.X-Goog-Authenticated-User-Email}
# IDENTITY_STRIP_PREFIX=accounts.google.com:

# --- AWS: Application Load Balancer with an authenticate-oidc action ----------
# x-amzn-oidc-identity is the IdP's "sub" claim. x-amzn-oidc-data is a signed
# JWT with the full claim set; verify it in the API if you want the name and
# email cryptographically, rather than trusting the plain header.
# IDENTITY_ID_SOURCE={http.request.header.X-Amzn-Oidc-Identity}
# IDENTITY_NAME_SOURCE={http.request.header.X-Amzn-Oidc-Identity}
# IDENTITY_EMAIL_SOURCE={http.request.header.X-Amzn-Oidc-Identity}

# --- Azure: App Service / Container Apps "Easy Auth" with Microsoft Entra ID --
# X-Ms-Client-Principal is base64 JSON with every claim; the two scalar headers
# are the convenient subset.
# IDENTITY_ID_SOURCE={http.request.header.X-Ms-Client-Principal-Id}
# IDENTITY_NAME_SOURCE={http.request.header.X-Ms-Client-Principal-Name}
# IDENTITY_EMAIL_SOURCE={http.request.header.X-Ms-Client-Principal-Name}

# --- Self-hosted oauth2-proxy / Keycloak gatekeeper ---------------------------
# IDENTITY_ID_SOURCE={http.request.header.X-Forwarded-User}
# IDENTITY_NAME_SOURCE={http.request.header.X-Forwarded-Preferred-Username}
# IDENTITY_EMAIL_SOURCE={http.request.header.X-Forwarded-Email}

# -----------------------------------------------------------------------------
# What the API reads. These must match the header names written in
# proxy/Caddyfile -- change one, change both.
# -----------------------------------------------------------------------------
AUTH_HEADER_ID=X-Auth-Request-User
AUTH_HEADER_NAME=X-Auth-Request-Name
AUTH_HEADER_EMAIL=X-Auth-Request-Email

# Prefix the API removes from the identity before storing it. Needed only for
# Google IAP, where it is set INSIDE the Google block above. Do not set it empty
# here: compose takes the LAST value in this file, so an active line down here
# would silently undo the one up there, and every access list would be built from
# "accounts.google.com:"-prefixed ids that stop matching later (#35).
# IDENTITY_STRIP_PREFIX=

# Refuse any request with no identity instead of inventing an anonymous user.
# Leave this true. Sign-offs recorded against "anonymous" are worthless for audit.
REQUIRE_IDENTITY=true

# Second line of defense: the API rejects a connection whose peer address is
# outside this range, so a networking mistake cannot quietly turn the identity
# header into a free-for-all. 172.16.0.0/12 is Docker's default bridge pool.
# Narrow it to the proxy's address, or to the load balancer's subnet, if you can.
TRUSTED_PROXY_CIDR=172.16.0.0/12

# Third lock, off while empty: a secret the proxy sends the API in X-Proxy-Secret
# and the API requires. compose.yaml hands this one value to both, so setting it
# here turns the check on at both ends; it authenticates the proxy to the API,
# not a caller to the proxy. Generate one: openssl rand -hex 32
PROXY_SHARED_SECRET=

# -----------------------------------------------------------------------------
# API image
# -----------------------------------------------------------------------------
# Unset: compose builds ./api locally and tags it chai-governance-api:local.
# In a cloud, point this at a registry tag pinned by digest:
#   API_IMAGE=europe-west4-docker.pkg.dev/PROJECT/chai/api@sha256:abc123...
# API_IMAGE=chai-governance-api:local

LOG_LEVEL=info

# "json" (default): one object per line, with security events named and tagged
# `"stream": "security"` so a log sink can alert on and retain them (docs/deploy.md,
# "Security events"). "text": the human-readable line, for a terminal.
# LOG_FORMAT=json

# -----------------------------------------------------------------------------
# ENCRYPTION AT REST (#47). The database lives in the Docker volume `pgdata`, a plain
# directory on this host's disk; nothing in this stack encrypts it. Put Docker's data
# root on an encrypted volume (docs/self-hosting.md, "Encryption at rest"), THEN set
# this. It is you saying it is done: nothing in a container can check. `make up`
# refuses a stack reachable beyond this machine (HTTP_BIND not loopback) without it.
# STORAGE_ENCRYPTION_CONFIRMED=1

# -----------------------------------------------------------------------------
# SESSIONS (#49). The application has no session of its own, so the automatic
# logoff that HIPAA 164.312(a)(2)(iii) asks about is your SSO front door's session
# lifetime: set it there (docs/deploy.md lists where, for each front door). These
# three are defense in depth on top of that.
#
# IDLE_LOCK_MINUTES: lock the dashboard after this many minutes without input, hide
# the record, and ask for a reload (which goes back through the front door). Unsaved
# edits are saved first. 0 is off.
# IDLE_LOCK_MINUTES=15
# SSE_MAX_LIFETIME_SECONDS: how long one live-update stream may stay open before the
# server ends it and the browser has to reconnect through the front door. This is what
# stops a stream opened before an account was disabled from outliving it. 0 is no limit.
# SSE_MAX_LIFETIME_SECONDS=900
# SIGN_OUT_URL: where your front door ends a session, shown as a "Sign out" link. An
# https URL, or a path on this origin (for example /.auth/logout).
# SIGN_OUT_URL=/.auth/logout

# -----------------------------------------------------------------------------
# EMERGENCY ACCESS (#42). Identity ids, comma-separated, as your SSO front door
# asserts them. Each holds owner rights on EVERY project, so a record whose only
# owner has left stays reachable. Every use is written to that project's own audit
# log and to the `chai.emergency` log. Empty means nobody has it. See
# docs/deploy.md, "Offboarding, and emergency access".
# EMERGENCY_ACCESS_IDS=security.officer@hospital.org

# -----------------------------------------------------------------------------
# THE BUILD (#168, D-76). Which dashboard build the stack serves, and the policy
# generated with it. The defaults are the published build. APP_DIR must hold the
# page (index.html) and its manifest.json: the proxy serves the page, and the
# migrate job loads from the manifest which checkpoint decisions end a project, so
# when disposal is due follows the same framework the page shows. CSP_FILE must be
# the policy generated with that page, or the browser refuses its script.
# APP_DIR=./docs/app
# CSP_FILE=./proxy/csp.caddy
#
# RETIREMENT_RULES_ACK: the migrate job refuses (and the stack does not start) when a
# build would change which decisions end a project, by adding one or dropping one
# the database retires on today, or would change the primary framework. It lists the
# projects that would become due or stop being due for disposal and prints the value
# that acknowledges exactly that change, once, in this database; set it here to
# accept, then clear it once the stack is up. A database restored from a dump that
# creates the tables again (make restore) refuses it. A copy of the database's files
# (a snapshot, a base backup, a promoted replica) is the same database to it: it
# accepts again a value printed against the state it holds, and a staging database
# made that way accepts production's values (build staging from a dump instead).
# So does a restore of the data alone into the existing tables (--data-only, or
# TRUNCATE and reload). Clear it before restoring either. After a deploy, check
# `docker compose ps -a`: over a running stack `up -d` can return 0 with migrate
# exited 3 and the proxy not started.
# It binds the rules, not the projects: one edited before you use it is affected
# without having been listed.
# RETIREMENT_RULES_ACK=

# -----------------------------------------------------------------------------
# RESOURCE LIMITS (compose.yaml; defaults suit a governance workload, which is
# kilobytes of documents). Raise them if you see a container killed for memory.
# -----------------------------------------------------------------------------
# DB_MEM_LIMIT=1g
# DB_CPUS=2
# API_MEM_LIMIT=512m
# API_CPUS=2
# PROXY_MEM_LIMIT=256m
# PROXY_CPUS=1

# -----------------------------------------------------------------------------
# Development-only (read by compose.dev.yaml, ignored by compose.yaml)
# -----------------------------------------------------------------------------
DEV_API_PORT=8000
DEV_IDENTITY_ID=dev@localhost
DEV_IDENTITY_NAME=Dev User
DEV_IDENTITY_EMAIL=dev@localhost

# -----------------------------------------------------------------------------
# DATABASE TRANSPORT
#
# asyncpg's default sslmode is "prefer": it tries TLS and SILENTLY ACCEPTS an
# unencrypted connection if the server does not offer one. Fine on the
# internal compose bridge; not fine the moment DATABASE_URL points at a
# managed instance, which is the same string with a different host.
#
# The API warns at startup when a remote DSN has no sslmode or a weak one.
#   DATABASE_URL=postgresql://user:pw@host/db?sslmode=verify-full
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# BACKUPS
#
# `make backup` refuses to run without this: the dump is every record, every
# audit entry and every retained version in one file. make does not read .env, so
# EXPORT it in your shell (and never write `make backup BACKUP_PASSPHRASE=...`,
# which puts it on make's own command line):
#   export BACKUP_PASSPHRASE="$(openssl rand -base64 32)"
# Keep it somewhere OTHER than this machine. Without it the dump is
# unrecoverable.
#
# BACKUP_RETAIN=30   # prune all but the newest N dumps (default: keep all)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# AGENT API (#164) -- OFF unless AGENT_ID_SECRET is set. Read-only, per-user,
# 8-hour bearer tokens that a person mints in the app. Read docs/agent-api.md,
# and let the agent path through your front door, before turning it on.
# -----------------------------------------------------------------------------
# AGENT_ID_SECRET=                       # openssl rand -base64 48. Keys the opaque
#   ids the API shows for people. Keep it like a password; changing it changes every
#   id (nothing is lost: they are computed, never stored).
# AGENT_RATE_LIMIT_MAX_REQUESTS=60       # per token per rate-limit window; lower than
#   RATE_LIMIT_MAX_REQUESTS, which a person at a dashboard needs and a loop does not
# AGENT_MAX_ACTIVE_TOKENS=5              # live tokens one person may hold
# AGENT_EXTRA_VALUES=                    # comma-separated status and decision words of
#   a build of your own framework, beyond the published and example ones. Any other
#   stored value reaches an agent as null.

# -----------------------------------------------------------------------------
# OTHER LIMITS -- defaults are sensible; set only if you have a reason
# -----------------------------------------------------------------------------
# CSRF_TRUSTED_SITES=same-origin,none   # Sec-Fetch-Site values allowed to write
# REQUEST_BODY_LIMIT_BYTES=1048576      # reject API writes with larger bodies
# RATE_LIMIT_WINDOW_SECONDS=60          # rate-limit window size
# RATE_LIMIT_MAX_REQUESTS=240           # max API requests per identity/window
#   The limiter is in-process, so with N replicas the effective ceiling is
#   N x RATE_LIMIT_MAX_REQUESTS. Size it for one replica and treat the total
#   as approximate; it exists to blunt a runaway client, not to meter an API.
# SSE_MAX_STREAMS_PER_USER=8            # concurrent event streams per identity
